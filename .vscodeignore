# Everything the extension runs is bundled into dist/ by esbuild, so nothing
# from node_modules belongs in the VSIX - scan_vsix.mjs forbids it outright.
# Without this line, whether it ships depends on whether keytar (an optional
# dependency of @vscode/vsce) happened to install, which is why CI passed one
# run and failed the next with no dependency change.
node_modules/**
.vscode/**
.vscode-test/**
.github/**
.beads/**
.work/**
*.tgz
*.vsix
.env*
.npmrc
*.pem
*.key
*.p12
*.pfx
out/**
test/**
src/**
src/test/fixtures/**
**/*.map
**/*.ts
.gitignore
.nvmrc
.prettierrc.json
tsconfig.json
eslint.config.mjs
esbuild.config.mjs
package-lock.json
tools/**
scratch/**
tmp/**
temp/**
vsc-extension-quickstart.md
plan.md
plan_*.md
PLAN.md
SECURITY.md
AGENTS.md
CLAUDE.md
GEMINI.md
KIMI.md
icon.svg
lib/web/viewer.html
lib/**/*.map
lib/web/debugger.*
